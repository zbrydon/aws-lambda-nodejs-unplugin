{
  "name": "aws-lambda-nodejs-unplugin",
  "version": "0.0.0",
  "description": "A drop-in nodejs first replacement for aws_lambda_nodejs.NodejsFunction enabling handler bundling with unplugin supported bundlers.",
  "keywords": [
    "aws-cdk",
    "aws-lambda",
    "bundler",
    "cdk",
    "esbuild",
    "farm",
    "lambda",
    "nodejs",
    "nodejs-function",
    "rolldown",
    "rollup",
    "rspack",
    "unplugin",
    "vite",
    "webpack"
  ],
  "homepage": "https://github.com/zbrydon/aws-lambda-nodejs-unplugin#readme",
  "bugs": {
    "url": "https://github.com/zbrydon/aws-lambda-nodejs-unplugin/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/zbrydon/aws-lambda-nodejs-unplugin.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "imports": {
    "#src/*": {
      "aws-lambda-nodejs-unplugin/source": "./src/*",
      "default": "./dist/*"
    }
  },
  "exports": {
    ".": {
      "aws-lambda-nodejs-unplugin/source": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "imports": {
      "#src/*": "./dist/*"
    },
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "format": "oxfmt",
    "knip": "knip",
    "lint": "oxlint --type-aware --type-check",
    "release": "pnpm build && changeset publish",
    "test": "vitest run --project unit",
    "test:ci": "vitest run --coverage",
    "test:int": "vitest run --project integration",
    "test:watch": "vitest --project unit"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.3",
    "@changesets/cli": "2.31.0",
    "@farmfe/core": "1.7.11",
    "@rspack/core": "2.0.6",
    "@skuba-lib/changesets-changelog": "1.0.1",
    "@types/node": "24.13.2",
    "@vitest/coverage-v8": "4.1.8",
    "aws-cdk-lib": "2.257.0",
    "constructs": "10.6.0",
    "esbuild": "0.28.0",
    "knip": "6.16.1",
    "oxfmt": "0.53.0",
    "oxlint": "1.69.0",
    "oxlint-tsgolint": "0.23.0",
    "publint": "0.3.21",
    "rolldown": "^1.0.2",
    "rollup": "4.61.0",
    "tsconfig-seek": "2.0.0",
    "tsdown": "0.22.1",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.8",
    "webpack": "5.107.2"
  },
  "peerDependencies": {
    "@farmfe/core": ">=1.0.0",
    "@rspack/core": ">=1.0.0",
    "aws-cdk-lib": ">=2.130.0",
    "constructs": "^10.0.0",
    "esbuild": ">=0.20.0",
    "rolldown": ">=1.0.0",
    "rollup": ">=4.0.0",
    "vite": ">=6",
    "webpack": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@farmfe/core": {
      "optional": true
    },
    "@rspack/core": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    },
    "rolldown": {
      "optional": true
    },
    "rollup": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "webpack": {
      "optional": true
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.5.1"
    }
  },
  "engines": {
    "node": ">=24.14.0"
  }
}
